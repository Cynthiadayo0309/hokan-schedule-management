{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "訪問スケジュール管理",
  "version": "0.1.0",
  "identifier": "jp.local.visit-schedule",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "訪問スケジュール管理", "width": 1440, "height": 960, "minWidth": 1024, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "shortDescription": "訪問スケジュールの作成・編集・管理", "windows": { "nsis": { "languages": ["Japanese"], "displayLanguageSelector": false }, "webviewInstallMode": { "type": "skip" } } }
}
